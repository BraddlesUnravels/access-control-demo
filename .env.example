# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
# For local Supabase, you can auto-generate .env.local with: npm run infra:env
NEXT_SUPABASE_URL=your-project-url
NEXT_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only. Required to mint invite codes with `npm run invite:create`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Outer resume invite gate.
# Set ACCESS_GATE_DISABLED=true for local development convenience.
ACCESS_GATE_DISABLED=false
ACCESS_GATE_COOKIE_SECRET=local-access-gate-cookie-secret-that-meets-length-requirements
ACCESS_GATE_CODE_SECRET=local-access-gate-code-secret-that-meets-length-requirements

