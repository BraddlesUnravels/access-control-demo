{
  "version": "2.5.5",
  "description": "A small LMS demonstrating authentication, RBAC, resource ownership, and PostgreSQL row-level security.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:ui": "vitest run --project browser",
    "test:watch": "vitest --project node",
    "test:ui:watch": "vitest --project browser --browser.headless=false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "supabase start -x vector",
    "infra:down": "supabase stop --all --no-backup",
    "infra:reset": "supabase db reset",
    "infra:env": "node scripts/generate-local-env.mjs",
    "invite:create": "node scripts/create-access-invite.mjs",
    "demo:start": "npm install && npm run infra:up && npm run infra:env && npm run dev",
    "test:db": "node scripts/run-rls-tests.mjs",
    "db:types": "supabase start -x vector && supabase gen types typescript --local > lib/supabase/database.types.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.110.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^16.3.0",
    "pino": "^9.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "swr": "^2.5.0",
    "tailwind-merge": "^3.3.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.25",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}
